{%- comment -%}
  Loomière teaser: temporary homepage takeover. Spec: Docs/loomiere-teaser-build-spec.md
  All content lives in Theme settings > "Loomière teaser" (so ka-hero reads the same switch).
  state off (or blank): renders nothing. teaser: WhatsApp appointment CTA.
  live: CTA to /collections/loomiere, but only if that collection has published products; else behaves as teaser.
{%- endcomment -%}
{%- assign lt_state = settings.loomiere_state | default: 'off' -%}
{%- if lt_state != 'off' -%}
  {%- assign lt_is_live = false -%}
  {%- if lt_state == 'live' and collections['loomiere'] != blank and collections['loomiere'].products_count > 0 -%}
    {%- assign lt_is_live = true -%}
  {%- endif -%}
  {%- assign lt_name = settings.loomiere_name | default: 'Loomière' -%}
  {%- assign lt_prefill = "Hello K&A, I'd like to book a styling appointment to see " | append: lt_name | append: ' first' -%}
  {%- assign lt_fdx = settings.loomiere_focal_desktop_x | default: '70%' -%}
  {%- assign lt_fdy = settings.loomiere_focal_desktop_y | default: '88%' -%}
  {%- assign lt_fpx = settings.loomiere_focal_phone_x | default: '52%' -%}
  {%- assign lt_fpy = settings.loomiere_focal_phone_y | default: '0%' -%}
  {%- assign lt_alt_d = settings.loomiere_alt_desktop | default: 'A model in a crimson couture gown by Karishma & Ashita, reclining, in warm studio light' -%}
  {%- assign lt_alt_p = settings.loomiere_alt_phone | default: 'A model in a fuchsia couture corset and drape skirt by Karishma & Ashita' -%}
  {{ 'ka-loomiere-teaser.css' | asset_url | stylesheet_tag }}

  <section class="lt" aria-label="{{ lt_name | escape }}" style="--fx:{{ lt_fdx }};--fy:{{ lt_fdy }};--pfx:{{ lt_fpx }};--pfy:{{ lt_fpy }}">
    <div class="lt__media">
      <picture>
        {%- if settings.loomiere_image_phone != blank -%}
          <source media="(max-width:700px)" srcset="{{ settings.loomiere_image_phone | image_url: width: 800 }} 800w, {{ settings.loomiere_image_phone | image_url: width: 1200 }} 1200w" sizes="100vw">
        {%- else -%}
          <source media="(max-width:700px)" srcset="{{ 'loomiere-teaser-phone.jpg' | asset_url }}">
        {%- endif -%}
        {%- if settings.loomiere_image_desktop != blank -%}
          <img src="{{ settings.loomiere_image_desktop | image_url: width: 2000 }}"
               srcset="{{ settings.loomiere_image_desktop | image_url: width: 1200 }} 1200w, {{ settings.loomiere_image_desktop | image_url: width: 1800 }} 1800w, {{ settings.loomiere_image_desktop | image_url: width: 2400 }} 2400w"
               sizes="100vw" alt="{{ lt_alt_d | escape }}" loading="eager" fetchpriority="high" width="2400" height="1800">
        {%- else -%}
          <img src="{{ 'loomiere-teaser-desktop.jpg' | asset_url }}" alt="{{ lt_alt_d | escape }}" loading="eager" fetchpriority="high" width="2400" height="1800">
        {%- endif -%}
      </picture>
    </div>
    <div class="lt__scrim"></div>
    <div class="lt__content">
      {%- if settings.loomiere_eyebrow != blank -%}<p class="lt__eyebrow">{{ settings.loomiere_eyebrow | escape }}</p>{%- endif -%}
      <p class="lt__kicker">{%- if lt_is_live -%}{{ settings.loomiere_headline_live | default: 'Introducing' | escape }}{%- else -%}{{ settings.loomiere_headline_teaser | default: 'Launching soon' | escape }}{%- endif -%}</p>
      <h1 class="lt__name">{{ lt_name | escape }}</h1>
      {%- if settings.loomiere_line != blank -%}<p class="lt__line">{{ settings.loomiere_line | escape }}</p>{%- endif -%}
      {%- if lt_is_live -%}
        <a class="lt__cta" href="{{ routes.collections_url }}/loomiere">{{ settings.loomiere_cta_live | default: 'Explore the collection' | escape }}</a>
      {%- else -%}
        <a class="lt__cta" href="https://wa.me/{{ settings.whatsapp_number }}?text={{ lt_prefill | url_encode }}" target="_blank" rel="noopener" data-ka-enquiry="appointment" data-ka-placement="home-loomiere-teaser">{{ settings.loomiere_cta_teaser | default: 'Book a styling appointment to see it first' | escape }}</a>
      {%- endif -%}
      {%- if settings.loomiere_more_label != blank -%}
        <a class="lt__more" href="{{ settings.loomiere_more_url | default: routes.collections_url }}">{{ settings.loomiere_more_label | escape }}</a>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Loomière teaser",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "Content and the Off / Teaser / Live switch are in Theme settings > Loomière teaser. Keep this section directly above Hero."
    }
  ],
  "presets": [
    { "name": "Loomière teaser" }
  ]
}
{% endschema %}
