{{ 'ka-article-body.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  K&A Article Body — Docs/journal-build-spec.md §3 B4/B5/B6.

  Body copy (B4) renders article.content directly (Shopify's native
  rich-text article editor) — no metafield needed for paragraphs or
  H2 subheads; see assets/ka-article-body.css header comment for how
  the "lede" larger-first-paragraph treatment and the H2 italic style
  are achieved with plain CSS selectors against whatever an editor
  writes in Admin.

  Pull-quote (B5) is also authored directly in the rich-text editor
  using Shopify's native "Quote" block (renders as <blockquote>) —
  styled to match .ka-manifesto by assets/ka-article-body.css. No
  metafield, no custom markup.

  Breakout image (B6) — FEASIBILITY NOTE: a plain rich-text image in
  article.content cannot visually escape the 720px text column (that
  is a genuine Liquid/rich-text limitation, not a simplification we
  chose casually) — see spec §6/§7. Per-article source order:
    1. section.settings.breakout_image (theme-editor override, wins
       if set).
    2. article.metafields.custom.breakout_image (per-article file/
       image reference metafield — the real per-article path, gap-
       fixed 2026-08-08; requires a metafield DEFINITION to exist on
       the Article resource before any value can be set on it in
       Admin — see below).
    3. Static placeholder (about-craft-detail-2.jpg, per spec §5) —
       so nothing breaks/goes blank on the 4 already-live articles
       until the per-article metafield is populated.
  Position: if the article body contains the literal marker text
  "[breakout]" (typed by the content editor at the point in the
  article where the image should interrupt the column), this section
  splits article.content on that marker and injects the breakout
  figure at that position. If no marker is present, the breakout
  renders once, after the full body (a correct but less precisely-
  positioned fallback).

  Metafield DEFINITION status (custom.breakout_image, Article
  resource, file/image reference) — checked 2026-08-08 via Shopify
  Admin GraphQL (metafieldDefinitions(ownerType: ARTICLE)): does NOT
  exist yet. Technical Director's Admin API access is read-only
  (graphql_query only, no graphql_mutation) — cannot create metafield
  definitions itself. Must be created via Shopify Admin UI (Settings
  -> Custom data -> Articles -> Add definition, type "File reference"
  or "Single image") or a one-time authenticated mutation run outside
  this read-only session, then populated per-article. Until that
  definition exists, article.metafields.custom.breakout_image safely
  resolves to blank on every article, so this section always falls
  through to the static placeholder — nothing breaks.
{%- endcomment -%}

{%- liquid
  assign marker = '[breakout]'
  assign has_marker = false
  if article.content contains marker
    assign has_marker = true
  endif

  assign breakout_image = section.settings.breakout_image
  if breakout_image == blank
    assign breakout_image = article.metafields.custom.breakout_image
  endif
  assign breakout_is_placeholder = false
  if breakout_image == blank
    assign breakout_is_placeholder = true
  endif

  assign breakout_caption = section.settings.breakout_caption
  if breakout_caption == blank
    assign breakout_caption = article.metafields.custom.breakout_caption
  endif
-%}

{%- if has_marker -%}
  {%- assign content_parts = article.content | split: marker -%}
  <article class="a-body-wrap">
    <div class="a-body">{{ content_parts[0] }}</div>
  </article>

  <figure class="a-breakout reveal-img">
    <div class="a-breakout__frame">
      {%- if breakout_is_placeholder -%}
        <img
          src="{{ 'about-craft-detail-2.jpg' | asset_url }}"
          alt="{{ breakout_caption | default: article.title | escape }}"
          loading="lazy"
          width="1600"
          height="1000"
          class="img-filter-editorial"
        />
      {%- else -%}
        <img
          src="{{ breakout_image | image_url: width: 1600 }}"
          alt="{{ breakout_image.alt | escape | default: article.title | escape }}"
          loading="lazy"
          width="1600"
          height="1000"
          class="img-filter-editorial"
        />
      {%- endif -%}
    </div>
    {%- if breakout_caption != blank -%}<figcaption class="a-breakout__caption">{{ breakout_caption }}</figcaption>{%- endif -%}
  </figure>

  <article class="a-body-wrap" style="padding-top: 0;">
    <div class="a-body">{{ content_parts[1] }}</div>
  </article>
{%- else -%}
  <article class="a-body-wrap">
    <div class="a-body">{{ article.content }}</div>
  </article>

  <figure class="a-breakout reveal-img">
    <div class="a-breakout__frame">
      {%- if breakout_is_placeholder -%}
        <img
          src="{{ 'about-craft-detail-2.jpg' | asset_url }}"
          alt="{{ breakout_caption | default: article.title | escape }}"
          loading="lazy"
          width="1600"
          height="1000"
          class="img-filter-editorial"
        />
      {%- else -%}
        <img
          src="{{ breakout_image | image_url: width: 1600 }}"
          alt="{{ breakout_image.alt | escape | default: article.title | escape }}"
          loading="lazy"
          width="1600"
          height="1000"
          class="img-filter-editorial"
        />
      {%- endif -%}
    </div>
    {%- if breakout_caption != blank -%}<figcaption class="a-breakout__caption">{{ breakout_caption }}</figcaption>{%- endif -%}
  </figure>
{%- endif -%}

{% schema %}
{
  "name": "Article Body",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "Body copy, H2 subheads and the pull-quote all come directly from the article's own rich-text content in Shopify Admin (Blog posts editor) — nothing to configure here. To position the breakout image mid-article, type the literal text [breakout] on its own line at the point in the article body where it should appear."
    },
    { "type": "image_picker", "id": "breakout_image", "label": "Breakout image override", "info": "Falls back to the article's custom.breakout_image metafield if set, then to a static placeholder image so the breakout always renders." },
    { "type": "text", "id": "breakout_caption", "label": "Breakout caption override", "info": "Falls back to the article's custom.breakout_caption metafield if set." }
  ],
  "presets": [
    { "name": "Article Body" }
  ]
}
{% endschema %}
