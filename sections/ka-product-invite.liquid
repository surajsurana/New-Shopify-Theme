{{ 'ka-product-invite.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign wa = settings.whatsapp_number
  assign wa_appt_text = "Hello K&A, I'd like to book an appointment for " | append: product.title | append: ' (' | append: canonical_url | append: ')'
  assign wa_appt_text_enc = wa_appt_text | url_encode
  assign appt_url = 'https://wa.me/' | append: wa | append: '?text=' | append: wa_appt_text_enc
  assign wa_text = "Hello K&A, I'd like to know more about " | append: product.title | append: ' (' | append: canonical_url | append: ')'
  assign wa_text_enc = wa_text | url_encode
  assign wa_enquire = 'https://wa.me/' | append: wa | append: '?text=' | append: wa_text_enc
-%}

<section class="ka-invite">
  <div class="ka-invite__inner reveal">
    <div class="ka-rule" style="margin:0 auto"></div>
    <div class="eyebrow" style="margin-top:24px">{{ section.settings.eyebrow }}</div>
    <h2>{{ section.settings.title }}</h2>
    <p>{{ section.settings.body }}</p>
    <div class="ka-invite__acts">
      <a class="ka-btn" href="{{ appt_url }}" target="_blank" rel="noopener" data-ka-enquiry="appointment" data-ka-placement="pdp-invite-appointment" data-ka-product="{{ product.handle }}">Book a Private Appointment</a>
      <a class="ka-btn ka-btn--concierge" href="{{ wa_enquire }}" target="_blank" rel="noopener" data-ka-enquiry="whatsapp" data-ka-placement="pdp-invite-concierge" data-ka-product="{{ product.handle }}"><span class="dot"></span>Speak with a Couture Concierge</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Conversation CTA",
  "tag": "section",
  "settings": [
    { "type": "url",      "id": "appointment_url", "label": "Appointment URL (dormant)", "info": "Not used: the button opens a WhatsApp appointment enquiry naming the product." },
    { "type": "text",     "id": "eyebrow", "label": "Eyebrow", "default": "The K&A Experience" },
    { "type": "text",     "id": "title",   "label": "Title",   "default": "Every Piece Begins with a Conversation" },
    { "type": "textarea", "id": "body",    "label": "Body", "default": "Tell us about your celebration. Our atelier will guide you on fit, fabric and customisation — with no obligation, only care." }
  ],
  "presets": [{ "name": "Conversation CTA" }]
}
{% endschema %}
