{{ 'ka-product-main.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign wa = settings.whatsapp_number
  # NOTE — appointment_url (schema setting below) is currently DORMANT.
  # Round 2 (Docs/cta-architecture-revision.md) routes "Book an Appointment"
  # through WhatsApp instead, as a TEMPORARY measure pending a real
  # booking flow/calendar. The setting is left in the schema (not removed)
  # so a future real booking flow has a ready slot to wire into — see
  # (2026-10-21: the CTA is now a real wa.me link, see wa_appt below).
  assign appt_url = section.settings.appointment_url | default: '/pages/appointments'
  assign price = product.price | money_without_trailing_zeros | replace: 'Rs.', '₹'

  # Item #27 (Docs/pending-tasks.md #27) — native photo-ratio gallery
  # boxes are now the STANDARD, permanent product-page behavior
  # (generalized site-wide 2026-09-11, after Suraj approved the fix on
  # the Electric Blue Victorian Corset trial). Every product's gallery
  # box now adapts to its own real photo aspect ratio instead of a
  # fixed 3:4 crop — see ka-stage--native-ratio / ka-thumb--native-ratio
  # below, applied unconditionally (gated only on an image actually
  # being present, same as the existing first_image / images-loop
  # guards already here — never on product.handle). Collection grid
  # cards and search results are explicitly OUT of scope — they keep
  # the fixed 3:4 box untouched, per Suraj's explicit scope decision.

  # Pre-filled WhatsApp enquiry with product context (F2)
  # 2026-10-21 (enquiry tracking): real wa.me links, product title + canonical URL in the message.
  # url_encode (not url_param_escape over a pre-encoded string) so "K&A" and apostrophes survive.
  assign wa_text = "Hello K&A, I'd like to know more about " | append: product.title | append: ' (' | append: canonical_url | append: ')'
  assign wa_text_enc = wa_text | url_encode
  assign wa_enquire = 'https://wa.me/' | append: wa | append: '?text=' | append: wa_text_enc
  assign wa_appt_text = "Hello K&A, I'd like to book an appointment for " | append: product.title | append: ' (' | append: canonical_url | append: ')'
  assign wa_appt_text_enc = wa_appt_text | url_encode
  assign wa_appt = 'https://wa.me/' | append: wa | append: '?text=' | append: wa_appt_text_enc

  # Made-to-measure-first layout (Docs/product-page-mobile-build-spec-2026-10-21.md, decision 3).
  # ON when the product's price is at/above the section setting "mtm_first_from" (INR, default
  # 50000 = the highest price that has ever converted online was Rs 48,000), unless the optional
  # product metafield custom.mtm_first (boolean: true = force on, false = force off; yes/no text also tolerated). Plain if/elsif,
  # no filters inside any case block (known silent-drop pattern).
  assign mtm_first = false
  assign mtm_override = product.metafields.custom.mtm_first.value | append: '' | downcase
  assign mtm_from_paise = section.settings.mtm_first_from | default: 50000 | times: 100
  if mtm_override == 'yes' or mtm_override == 'true'
    assign mtm_first = true
  elsif mtm_override == 'no' or mtm_override == 'false'
    assign mtm_first = false
  elsif product.price >= mtm_from_paise
    assign mtm_first = true
  endif
  assign back_url = product.collections.first.url | default: routes.all_products_collection_url
  assign back_label = product.collections.first.title | default: 'All Products'

  # Detect the Size option (case-insensitive) for variant-driven selection
  assign size_option = null
  for opt in product.options_with_values
    assign opt_down = opt.name | downcase
    if opt_down contains 'size'
      assign size_option = opt
    endif
  endfor

  # Per-product metafields (custom namespace) with graceful fallbacks
  assign poem = product.metafields.custom.poem_tagline
  assign lead_time = product.metafields.custom.lead_time | default: section.settings.default_lead_time
  # "working days" wording (Suraj, 2026-09-25): the stored values read "20–25 days" etc. but the
  # promise is WORKING days. Idempotent normaliser: only day-count values (containing "day") are
  # touched, week-based text ("6–8 Weeks") never is. (1) whitespace is collapsed (split/join, which
  # also trims); (2) when the value STARTS WITH A DIGIT, a spaced hyphen/en dash between the numbers
  # becomes a plain en dash, so "45 - 50 Days" reads "45–50" like the 20–25 / 30–35 / 40–45 tiers
  # (the digit guard stops it mangling prose such as "Ready to ship - 2 days"); (3) "working" is
  # appended only when neither "working" nor "business" is present. " Days" is lowercased first so
  # exactly ONE " days" -> " working days" replace runs (two chained replaces that both emit
  # " working days" would double-word it). Singular "day" is deliberately not handled: no value uses
  # it, and " day" would also match inside " working days".
  assign lead_time = lead_time | append: ''
  assign lead_time_lc = lead_time | downcase
  if lead_time_lc contains 'day'
    assign lead_time = lead_time | split: ' ' | join: ' '
    assign lt_first = lead_time | slice: 0
    if '0123456789' contains lt_first
      assign lead_time = lead_time | replace: ' - ', '–' | replace: ' – ', '–'
    endif
    unless lead_time_lc contains 'working' or lead_time_lc contains 'business'
      assign lead_time = lead_time | replace: ' Days', ' days' | replace: ' days', ' working days'
    endunless
  endif
  assign mf_atelier = product.metafields.custom.atelier_process
  # custom.fabric is a single_line_text_field (e.g. "Georgette") — shown as a label in the accordion
  assign mf_fabric = product.metafields.custom.fabric
  # custom.embroidery is a multi_line_text_field — per-product embroidery description; no generic fallback claim if blank
  assign mf_embroidery = product.metafields.custom.embroidery
  # custom.size_chart and custom.shipping are page_reference metafields — use .value to get the Page object, then .content for body HTML
  assign mf_sizefit = product.metafields.custom.size_chart.value
  assign mf_delivery = product.metafields.custom.shipping.value
-%}

<!-- Product JSON-LD (Docs/specs/2026-07-22-jsonld-structured-data.md).
     priceCurrency/price intentionally use shop.currency / product.price directly —
     NOT the ka-currency.js display-conversion mechanism (no data-price attribute
     here) — structured data must always reflect the real transactional currency
     (INR), regardless of what a visitor sees rendered client-side. -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | json }},
  "sku": {{ product.selected_or_first_available_variant.sku | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | json }}
  },
  "image": [
    {%- for image in product.images limit: 5 -%}
      "{{ image | image_url: width: 1200 }}"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "url": "{{ product.url | prepend: shop.url }}",
  "offers": {
    "@type": "Offer",
    "priceCurrency": "{{ shop.currency }}",
    "price": {{ product.price | divided_by: 100.0 | round: 2 }},
    "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
    "url": "{{ product.url | prepend: shop.url }}"
  }
}
</script>

<section class="ka-product{% if mtm_first %} ka-product--mtm{% endif %}" id="ka-product">

  <!-- ── Gallery: sticky thumbnail rail + stage ── -->
  <div class="ka-media" id="ka-media">
    {%- assign first_image = product.featured_image -%}
    {%- comment -%} --ratio-m: phone/tablet frame ratio, clamped 0.5-1.0 (ka-product.js updates it per slide) {%- endcomment -%}
    {%- if first_image -%}{%- assign ratio_m = first_image.aspect_ratio | default: 0.75 | at_least: 0.5 | at_most: 1.0 -%}{%- endif -%}
    <div
      class="ka-stage{% unless first_image %} ka-stage--ph{% endunless %}{% if first_image %} ka-stage--native-ratio{% endif %}"
      id="ka-stage"
      {% if first_image %}style="background-image:url('{{ first_image | image_url: width: 1400 }}'); --ratio: {{ first_image.aspect_ratio }}; --ratio-m: {{ ratio_m }};"{% endif %}
    >
      {%- comment -%}
        MOBILE ONLY (<=900px): native swipe gallery replaces the thumbnail strip. On desktop this
        whole block is display:none and the stage/thumbs behave exactly as before. Slides use an
        absolutely-positioned <img> (no aspect-ratio on flex items: Safari collapse bug).
      {%- endcomment -%}
      {%- if product.images.size > 0 -%}
      <div class="ka-swipe" id="ka-swipe" tabindex="0" aria-label="{{ product.title | escape }} photographs">
        {%- for image in product.images -%}
          <div class="ka-swipe__slide">
            {%- if forloop.first -%}<picture><source media="(min-width: 901px)" srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="> {%- endif -%}
            <img
              src="{{ image | image_url: width: 900 }}"
              srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1200 }} 1200w"
              sizes="100vw"
              width="{{ image.width }}" height="{{ image.height }}"
              alt="{{ image.alt | default: product.title | escape }}"
              {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
              draggable="false">
            {%- if forloop.first -%}</picture>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="ka-dots" id="ka-dots" aria-hidden="true">
          {%- for image in product.images -%}<i{% if forloop.first %} class="on"{% endif %}></i>{%- endfor -%}
        </div>
      {%- endif -%}
      {%- endif -%}
      <a class="ka-back" href="{{ back_url }}" aria-label="Back to {{ back_label }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></a>
      <span class="ka-stage__idx" id="ka-stage-idx">01 / {% if product.images.size > 0 %}{{ product.images.size | prepend: '0' | slice: -2, 2 }}{% else %}01{% endif %}</span>
      <span class="ka-stage__zoom" aria-hidden="true">&#10530; Zoom</span>
      {%- comment -%}
        Wishlist heart — Docs/account-wishlist-build-spec.md S6. Top-right
        of the gallery stage, deliberately excluded from the info panel,
        CTA stack, and both sticky action bars (see that spec's placement
        rationale, mirrored from Prototypes/product-page-wishlist-v1.html
        Sections 1/3) — do not add a heart to those four surfaces even if
        it looks like a small, convenient addition later; this was an
        explicit, reasoned rejection in the approved prototype, not an
        oversight. data-product-handle lets assets/ka-wishlist.js identify
        this button (Section 1.4). assets/ka-product.js's lightbox click
        handler on #ka-stage excludes clicks on this button (see that
        file), so tapping the heart never also opens the lightbox.
      {%- endcomment -%}
      <button type="button" class="ka-stage__wish" data-product-handle="{{ product.handle }}" aria-label="Save to wishlist" aria-pressed="false">
        <svg class="heart-line" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.35-9.5-8.5C.8 8.3 1.4 4.9 4.4 3.6c2.1-.9 4.4-.2 5.7 1.6L12 7.4l1.9-2.2c1.3-1.8 3.6-2.5 5.7-1.6 3 1.3 3.6 4.7 1.9 7.9C19 15.65 12 20 12 20z"/></svg>
        <svg class="heart-fill" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.35-9.5-8.5C.8 8.3 1.4 4.9 4.4 3.6c2.1-.9 4.4-.2 5.7 1.6L12 7.4l1.9-2.2c1.3-1.8 3.6-2.5 5.7-1.6 3 1.3 3.6 4.7 1.9 7.9C19 15.65 12 20 12 20z"/></svg>
      </button>
    </div>

    <div class="ka-thumbs" id="ka-thumbs">
      {%- for image in product.images -%}
        <button
          type="button"
          class="ka-thumb{% if forloop.first %} active{% endif %} ka-thumb--native-ratio"
          data-full="{{ image | image_url: width: 1400 }}"
          aria-label="View image {{ forloop.index }}"
          style="background-image:url('{{ image | image_url: width: 200 }}'); --ratio: {{ image.aspect_ratio }};"
        ></button>
      {%- else -%}
        <button type="button" class="ka-thumb active ka-thumb--ph" aria-label="Product image"></button>
      {%- endfor -%}
    </div>
  </div>

  <!-- ── Info panel ── -->
  <div class="ka-info-wrap">
    <div class="ka-panel">
      {%- if product.collections.first -%}
        <a href="{{ product.collections.first.url }}" class="eyebrow ka-collection-tag">{{ product.collections.first.title }}</a>
      {%- endif -%}

      <h1 class="ka-p-title">{{ product.title }}</h1>

      {%- if poem != blank -%}
        <p class="ka-p-poem">{{ poem }}</p>
      {%- endif -%}

      {%- comment -%}
        Google rating badge: reads the live-synced Shop metafield
        custom.google_reviews (scripts/google-reviews-sync) when it is populated
        -- same "is there real data" rule as the homepage section (needs a
        rating and count and at least one synced review) -- otherwise the
        section settings below are used exactly as before. Synced values are
        untrusted text, so they are escaped.
      {%- endcomment -%}
      {%- liquid
        assign gr = shop.metafields.custom.google_reviews.value
        assign gr_quotes = 0
        for gr_review in gr.reviews
          if gr_review.quote != blank
            assign gr_quotes = gr_quotes | plus: 1
          endif
        endfor
        assign badge_score = section.settings.rating_score
        assign badge_count = section.settings.rating_count
        if gr != blank and gr_quotes > 0 and gr.rating_number != blank and gr.rating_count != blank
          assign badge_score = gr.rating_number | escape
          assign badge_count = gr.rating_count | escape
        endif
      -%}
      <button type="button" class="ka-grating" id="ka-grating" title="Read our Google reviews">
        <span class="ka-grating__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span class="ka-grating__tx"><b>{{ badge_score }}</b> · {{ badge_count }} reviews on</span>
        <span class="ka-glogo"><span class="b">G</span><span class="r">o</span><span class="y">o</span><span class="b">g</span><span class="g2">l</span><span class="r">e</span></span>
      </button>

      <div class="ka-p-price-row">
        <div class="ka-p-price" data-price="{{ product.price }}">{{ price }}</div>
        <div class="ka-p-tax">Taxes included</div>
      </div>
      <div class="ka-p-made">Made to measure · Crafted to order in {{ lead_time }}</div>

      <!-- SIZE + BESPOKE (mapped to Shopify variant option) -->
      {%- comment -%}.ka-buy groups the purchase controls so that on mobile the made-to-measure card can lead (CSS order) on high-ticket pieces. No visual change on desktop.{%- endcomment -%}
      <div class="ka-buy{% if mtm_first %} ka-buy--mtm{% endif %}">
      <div class="ka-opt-head">
        <span class="ka-opt-label"><span class="ka-opt-label__d">Select Your Size</span>{% if mtm_first %}<span class="ka-opt-label__m">Or choose a standard size</span>{% endif %}</span>
        <button type="button" class="ka-btn-line" data-open-acc="size">Size &amp; Fit Guide</button>
      </div>

      <div class="ka-size-grid" id="ka-sizes">
        {%- if size_option -%}
          {%- for value in size_option.values -%}
            {%- assign v_down = value | downcase -%}
            {%- unless v_down contains 'measure' or v_down contains 'bespoke' or v_down contains 'custom' -%}
              {%- comment -%}
                Find the matching variant for this size value so the button
                can carry a real numeric Shopify variant ID — /cart/add.js
                needs an id, not an option label. If the product has other
                option dimensions (e.g. Colour) this takes the first
                available variant matching this size; a single-option
                "Size only" product (the common case here) matches exactly.
              {%- endcomment -%}
              {%- assign matched_variant = null -%}
              {%- for v in product.variants -%}
                {%- if v.available and matched_variant == null -%}
                  {%- for opt_val in v.options -%}
                    {%- if opt_val == value -%}
                      {%- assign matched_variant = v -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              {%- endfor -%}
              {%- unless matched_variant -%}
                {%- for v in product.variants -%}
                  {%- if matched_variant == null -%}
                    {%- for opt_val in v.options -%}
                      {%- if opt_val == value -%}
                        {%- assign matched_variant = v -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endunless -%}
              <button
                type="button"
                class="ka-size{% if matched_variant == null or matched_variant.available == false %} ka-size--oos{% endif %}"
                data-value="{{ value | escape }}"
                data-variant-id="{{ matched_variant.id }}"
                {% if matched_variant == null or matched_variant.available == false %}aria-disabled="true"{% endif %}
              >{{ value }}</button>
            {%- endunless -%}
          {%- endfor -%}
        {%- else -%}
          {%- comment -%}
            Fallback when no Size option exists yet on the product — there
            is no real variant to map, so these render disabled rather than
            pretending to be addable. A product launched without a Size
            option is a content gap, not something JS can paper over.
          {%- endcomment -%}
          <button type="button" class="ka-size ka-size--oos" data-value="XS" data-variant-id="" aria-disabled="true">XS</button>
          <button type="button" class="ka-size ka-size--oos" data-value="S" data-variant-id="" aria-disabled="true">S</button>
          <button type="button" class="ka-size ka-size--oos" data-value="M" data-variant-id="" aria-disabled="true">M</button>
          <button type="button" class="ka-size ka-size--oos" data-value="L" data-variant-id="" aria-disabled="true">L</button>
          <button type="button" class="ka-size ka-size--oos" data-value="XL" data-variant-id="" aria-disabled="true">XL</button>
        {%- endif -%}
      </div>

      {%- comment -%}
        Find the "Made to my measurements" / bespoke variant (any size option
        value that contains 'measure' or 'bespoke') so the button can carry
        a real Shopify variant ID — this lets Add to Bag do a literal cart add
        instead of routing to WhatsApp. If no such variant exists on the product,
        the button renders without data-variant-id and ka-product.js gracefully
        falls back to the WhatsApp flow.
      {%- endcomment -%}
      {%- assign bespoke_variant = null -%}
      {%- for v in product.variants -%}
        {%- if bespoke_variant == null -%}
          {%- for opt_val in v.options -%}
            {%- assign ov_down = opt_val | downcase -%}
            {%- if ov_down contains 'measure' or ov_down contains 'bespoke' -%}
              {%- assign bespoke_variant = v -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if bespoke_variant -%}
        {%- comment -%}Real MTM variant — add to cart directly, no special properties needed.{%- endcomment -%}
        <button class="ka-bespoke" id="ka-bespoke" type="button" data-variant-id="{{ bespoke_variant.id }}"{% if mtm_first %} data-preselect="true"{% endif %}>
      {%- else -%}
        {%- comment -%}No dedicated MTM variant — use first available variant as fallback.
          ka-product.js will add "Size: Made to my measurements" as a line-item property
          so the order reads correctly for the designer.{%- endcomment -%}
        <button class="ka-bespoke" id="ka-bespoke" type="button"
          data-variant-id="{{ product.selected_or_first_available_variant.id }}"
          data-mtm-fallback="true"{% if mtm_first %} data-preselect="true"{% endif %}>
      {%- endif -%}
        <span class="ka-bespoke__dot" aria-hidden="true"></span>
        <span class="ka-bespoke__txt">
          <span class="ka-bespoke__k">Made to my measurements</span>
          <span class="ka-bespoke__n">Your designer will call within one working day of your order.</span>
        </span>
        <span class="ka-bespoke__s">Recommended</span>
      </button>
      <button type="button" class="ka-mtm-toggle" id="ka-mtm-toggle" aria-expanded="false" aria-controls="ka-mtm">How it works</button>

      <!-- MADE-TO-MEASURE reveal -->
      <div class="ka-mtm" id="ka-mtm">
        <div class="ka-mtm__inner">
          <h4>How Your Piece Comes to Life</h4>
          <ul class="ka-mtm__steps">
            <li>Place your order — no measurements needed yet. Your designer will be in touch within one working day to begin. Already have your measurements? Add them to the order notes at checkout and we will take it from there.</li>
            <li>Confirm your fit with your designer — over WhatsApp, on a virtual call, or in our Mumbai atelier. We work at your pace, entirely.</li>
            <li>Our atelier cuts, drapes and hand-embroiders your piece to your exact measurements. Every element made for you alone.</li>
          </ul>
          <p class="ka-mtm__foot">Your piece is then pressed, quality-checked and delivered worldwide in {{ lead_time }}.</p>
          <button type="button" class="ka-mtm__link" data-open-acc="size">View the measurement guide &rarr;</button>
        </div>
      </div>

      <!--
        CTAs — Round 2 rebuild (Docs/cta-architecture-revision.md).
        Real Add to Bag via Ajax Cart API, gated on a Size selection (or
        the bespoke "Made to my measurements" path, which routes to
        WhatsApp/appointment instead of a literal cart add — see the
        OPEN DECISION note below). "Book an Appointment" is TEMPORARY:
        it routes to the same WhatsApp concierge destination as the
        Concierge button until a real appointment-booking flow/calendar
        exists. Do not let this silently become permanent.

        OPEN DECISION (resolved by Technical Director, this build):
        "Made to my measurements" does NOT map to a literal cart-line
        add. There is no fixed variant/SKU that represents "bespoke" —
        the prototype's own MTM panel describes a human-mediated
        measurement-confirmation step before production starts. Forcing
        it into /cart/add.js against a placeholder variant would create
        a paid cart line with no confirmed fit yet, which is friction in
        the wrong direction (a customer paying before the order is even
        specced). So: selecting bespoke + clicking "Add to Bag" routes
        to the same WhatsApp/appointment flow as "Book an Appointment",
        with on-page copy explaining why (see ka-product.js addToBag()).
        Sized variants still add to the real cart with zero friction —
        the common case stays a true one-click buy path, per CLAUDE.md's
        "buy path primary" principle.
      -->
      <div class="ka-cta-stack">
        <button type="button" class="ka-btn ka-btn--bag" id="ka-bag-btn" data-ka-add-to-bag aria-disabled="true">Add to Bag</button>
        <p class="ka-size-required-hint" id="ka-size-hint">Please select a size, or choose Made to my measurements.</p>
        <a class="ka-btn ka-btn--ghost" id="ka-cta-appt" href="{{ wa_appt }}" target="_blank" rel="noopener" data-ka-enquiry="appointment" data-ka-placement="pdp-appointment" data-ka-product="{{ product.handle }}">Book an Appointment</a>
      </div>

      {%- comment -%}MOBILE ONLY inline enquiry line (hidden on desktop). Real anchor, product pre-filled, tracked like every other enquiry link (assets/ka-theme.js reads data-ka-enquiry).{%- endcomment -%}
      <p class="ka-talk">Prefer to talk? <a href="{{ wa_enquire }}" target="_blank" rel="noopener" data-ka-enquiry="whatsapp" data-ka-placement="pdp-inline-whatsapp" data-ka-product="{{ product.handle }}">Message our designer on WhatsApp</a></p>
      </div><!-- /.ka-buy -->

      <!-- Toast: shared component, CSS in ka-base.css, JS in ka-theme.js (window.kaShowToast) -->
      <div class="ka-toast" id="kaToast" role="status" aria-live="polite">
        <span class="ka-toast__mark" aria-hidden="true">&#10022;</span>
        <div class="ka-toast__body">
          <div class="ka-toast__title">Added to Your Bag</div>
          <div class="ka-toast__sub" id="kaToastSub">&nbsp;</div>
        </div>
        <a class="ka-toast__action" href="{{ routes.cart_url }}">View Bag &rarr;</a>
      </div>

      <!-- ASSURANCES -->
      <div class="ka-assure">
        <div class="ka-assure__row"><span class="mk" aria-hidden="true">&#10022;</span><span>Each piece is cut, draped and hand-embroidered to order by our karigars — never machine-made.</span></div>
        <div class="ka-assure__row"><span class="mk" aria-hidden="true">&#10022;</span><span>Complimentary worldwide delivery by DHL Express, beautifully packaged.</span></div>
        <div class="ka-assure__row"><span class="mk" aria-hidden="true">&#10022;</span><span>Your designer accompanies every order, confirming your measurements and fit after you enquire.</span></div>
      </div>

      <!-- ACCORDION -->
      <div class="ka-accordion" id="ka-accordion">
        <div class="ka-acc" data-acc="atelier">
          <button class="ka-acc__head" type="button">The Atelier Process<span class="ka-acc__pm" aria-hidden="true">+</span></button>
          <div class="ka-acc__body"><div class="ka-acc__inner">
            {%- if mf_atelier != blank -%}{{ mf_atelier }}{%- else -%}
              Every Karishma &amp; Ashita piece is made to measure. After your enquiry, our atelier cuts and constructs the garment to your individual measurements, then hand-embroiders the corset over several weeks before a final press and quality check. Your piece reaches you in {{ lead_time }}.
            {%- endif -%}
          </div></div>
        </div>
        <div class="ka-acc" data-acc="fabric">
          <button class="ka-acc__head" type="button">Fabric &amp; Embroidery<span class="ka-acc__pm" aria-hidden="true">+</span></button>
          <div class="ka-acc__body"><div class="ka-acc__inner">
            {%- if mf_fabric != blank -%}<p class="ka-acc__fabric-label"><strong>Fabric:</strong> {{ mf_fabric }}</p>{%- endif -%}
            <ul>
              <li>Natural-fibre base fabrics — naturally breathable, fluid and soothing to wear</li>
              {%- if mf_embroidery != blank -%}<li>{{ mf_embroidery | newline_to_br }}</li>{%- endif -%}
              <li>Concealed boning and structure for a sculpted, confident silhouette</li>
            </ul>
          </div></div>
        </div>
        <div class="ka-acc" data-acc="size">
          <button class="ka-acc__head" type="button">Size &amp; Fit Guide<span class="ka-acc__pm" aria-hidden="true">+</span></button>
          <div class="ka-acc__body"><div class="ka-acc__inner">
            {%- if mf_sizefit != blank -%}{{ mf_sizefit.content }}{%- else -%}
              All measurements in inches. For a true couture fit, select <em>Made to my measurements</em> and share your details with your designer.
              <table>
                <tr><th></th><th>Bust</th><th>Waist</th><th>Hip</th></tr>
                <tr><th>XS</th><td>32</td><td>26</td><td>35</td></tr>
                <tr><th>S</th><td>34</td><td>28</td><td>38</td></tr>
                <tr><th>M</th><td>36</td><td>30</td><td>39</td></tr>
                <tr><th>L</th><td>38</td><td>32</td><td>40</td></tr>
                <tr><th>XL</th><td>40</td><td>34</td><td>42</td></tr>
              </table>
            {%- endif -%}
          </div></div>
        </div>
        <div class="ka-acc" data-acc="delivery">
          <button class="ka-acc__head" type="button">Delivery &amp; Care<span class="ka-acc__pm" aria-hidden="true">+</span></button>
          <div class="ka-acc__body"><div class="ka-acc__inner">
            {%- if mf_delivery != blank -%}
              <p class="ka-acc__delivery-lead">Crafted to order in {{ lead_time }}.</p>
              {{ mf_delivery.content }}
            {%- else -%}
              <ul>
                <li>Crafted to order in {{ lead_time }}</li>
                <li>Complimentary worldwide shipping via DHL Express</li>
                <li>Dry clean only — store flat, away from direct light</li>
                <li>As each piece is made to measure, kindly review our exchange policy with your designer</li>
              </ul>
            {%- endif -%}
          </div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── Sticky minibar (desktop) ── -->
<div class="ka-minibar" id="ka-minibar">
  <div class="ka-minibar__in">
    <div class="ka-minibar__l">
      <div class="ka-minibar__thumb"{% if product.featured_image %} style="background-image:url('{{ product.featured_image | image_url: width: 120 }}');"{% endif %}></div>
      <div>
        <div class="ka-minibar__name">{{ product.title }}</div>
        <div class="ka-minibar__price"><span data-price="{{ product.price }}">{{ price }}</span>{% if product.collections.first %} · {{ product.collections.first.title }}{% endif %}</div>
      </div>
    </div>
    <div class="ka-minibar__r">
      <a class="ka-btn ka-btn--ghost" href="{{ wa_appt }}" target="_blank" rel="noopener" data-ka-enquiry="appointment" data-ka-placement="pdp-minibar-appointment" data-ka-product="{{ product.handle }}">Book an Appointment</a>
      <button type="button" class="ka-btn ka-btn--bag" id="ka-minibar-bag" data-ka-add-to-bag aria-disabled="true">Add to Bag</button>
    </div>
  </div>
</div>

<!-- ── Mobile sticky action bar (<=900px) ──
     Two buttons only. Primary: charcoal "Message us on WhatsApp" (real anchor, product pre-filled).
     Secondary: "Select size" until a size / Made-to-measure is chosen, then "Add to Bag".
     The secondary keeps aria-disabled="true" while idle (JS shows the size hint on tap) but is
     styled as a normal outlined button, never greyed out. The separate "Appointment" button is
     retired from the bar: appointment requests are made in the WhatsApp chat. -->
<div class="ka-mobile-bar" role="group" aria-label="Order actions">
  <a class="ka-btn ka-btn--wa" href="{{ wa_enquire }}" target="_blank" rel="noopener" data-ka-enquiry="whatsapp" data-ka-placement="pdp-mobilebar-whatsapp" data-ka-product="{{ product.handle }}">
    <svg class="ka-wa-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1.3-4.2A8 8 0 1 1 8.4 18.8L4 20z"/></svg>
    <span>Message us on WhatsApp</span>
  </a>
  <button type="button" class="ka-btn ka-btn--bag" id="ka-mobilebar-bag" data-ka-add-to-bag data-label-idle="Select size" aria-disabled="true">Select size</button>
</div>
{%- comment -%}
  Hem clearance (Docs/cd-decisions-2026-10-22.md D1): on short phone screens the bar would cover
  the bottom of the photo on load, so it waits below the screen and slides up once the photo's
  bottom edge clears it. Once shown it stays. Inline so it applies before first paint; tall
  phones release it immediately with no animation.
{%- endcomment -%}
<script>
(function () {
  var bar = document.currentScript.previousElementSibling;
  var stage = document.getElementById('ka-stage');
  if (!bar || !stage || !window.matchMedia('(max-width: 900px)').matches) return;
  var done = false, tick = false;
  function clear() { return stage.getBoundingClientRect().bottom <= window.innerHeight - bar.offsetHeight; }
  function release(animate) {
    done = true;
    if (!animate) { bar.style.transition = 'none'; }
    bar.classList.remove('is-held');
    if (!animate) { bar.offsetHeight; bar.style.transition = ''; }
    window.removeEventListener('scroll', onChange);
    window.removeEventListener('resize', onChange);
  }
  function check(animate) { if (!done && clear()) release(animate); }
  function onChange() {
    if (tick) return;
    tick = true;
    window.requestAnimationFrame(function () { tick = false; check(true); });
  }
  bar.classList.add('is-held');
  window.addEventListener('scroll', onChange, { passive: true });
  window.addEventListener('resize', onChange);
  stage.addEventListener('transitionend', onChange);
  check(false);
  document.addEventListener('DOMContentLoaded', function () { check(false); });
  window.addEventListener('load', function () { check(false); });
})();
</script>

<!-- ── Lightbox (desktop/tablet only, disabled <900px via JS) ── -->
<div class="ka-lb" id="ka-lb">
  <span class="ka-lb__x" aria-hidden="true">Close &#10005;</span>
  <div class="ka-lb__frame" id="ka-lb-frame"></div>
</div>

