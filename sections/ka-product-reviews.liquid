{{ 'ka-product-reviews.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Live-synced data (2026-09-21): when the Shop metafield custom.google_reviews
  (written by scripts/google-reviews-sync) is populated -- same rule as the
  homepage voice-of-bride section: a rating + count and at least one synced
  review -- the score, count and up to 6 review cards come from it; otherwise
  the section settings/blocks below are used exactly as before. Every synced
  review is 4-5 stars and carries its numeric `rating`. Synced values are
  untrusted text (Liquid does not auto-escape), so every one is escaped. Quotes
  get a 70-word safety cap (truncatewords, then escape; ~60 words fits fine at
  this card width) per Docs/google-reviews-sections-build-spec.md sec 2/3.
  Grid layout for 6/5/4/3/2/1 cards is CSS-only (assets/ka-product-reviews.css).
{%- endcomment -%}
{%- liquid
  assign gr = shop.metafields.custom.google_reviews.value
  assign gr_quotes = 0
  for gr_review in gr.reviews
    if gr_review.quote != blank
      assign gr_quotes = gr_quotes | plus: 1
    endif
  endfor

  assign use_synced = false
  if gr != blank and gr_quotes > 0 and gr.rating_number != blank and gr.rating_count != blank
    assign use_synced = true
  endif

  if use_synced
    assign score = gr.rating_number | escape
    assign count = gr.rating_count | escape
    assign synced_url = gr.google_url
    if synced_url != blank
      assign more_url = synced_url | escape
    else
      assign more_url = section.settings.google_url
    endif
  else
    assign score = section.settings.rating_score
    assign count = section.settings.rating_count
    assign more_url = section.settings.google_url
  endif
-%}

<section class="ka-voice" id="reviews">
  <div class="reveal">
    <div class="ka-voice__glogo">Google Reviews</div>
    <div class="ka-voice__summary">
      <div class="ka-voice__score">{{ score }}</div>
      <div style="text-align:left">
        <div class="ka-voice__summary"><span class="ka-voice__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span></div>
        <div class="ka-voice__cnt">Based on {{ count }} reviews</div>
      </div>
    </div>
    <div class="ka-voice__head">{{ section.settings.heading }}</div>

    <div class="ka-rev-grid">
      {%- if use_synced -%}
        {%- for review in gr.reviews limit: 6 -%}
          {%- if review.quote != blank -%}
            {%- comment -%} plus: 0 coerces to a number (missing/non-numeric -> 0 -> no star row); round + at_most: 5 clamp to 1-5 {%- endcomment -%}
            {%- assign rating = review.rating | plus: 0 | round | at_most: 5 -%}
            <div class="ka-rev">
              {%- if rating > 0 -%}
                <div class="ka-rev__stars" role="img" aria-label="{{ rating }} out of 5 stars">
                  {%- for i in (1..5) -%}
                    {%- if i <= rating -%}&#9733;{%- else -%}&#9734;{%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
              <p>{{ review.quote | truncatewords: 70, '…' | escape }}</p>
              <div class="ka-rev__who">
                <div class="ka-rev__av">{{ review.reviewer_name | slice: 0 | escape }}</div>
                <div>
                  <div class="ka-rev__nm">{{ review.reviewer_name | escape }}</div>
                  <div class="ka-rev__src">via Google</div>
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
      {%- for block in section.blocks -%}
        {%- comment -%}
          Per-review star rating (2026-09-11, follow-up to the 64->67
          review-count update): was hardcoded to 5 filled stars for
          every card regardless of the reviewer's real Google rating
          (e.g. Sakshi K.'s 4-star review was misrepresented as 5).
          Now driven by block.settings.rating (1-5, default 5 so any
          existing/future block left unset renders identically to the
          old hardcoded behavior). Same glyph family/size/color as
          before (--rosegold-pale) -- filled stars (&#9733;) up to the
          rating, outline stars (&#9734;) for the remainder, so a 4-star
          card visually reads as 4-of-5, not a dimmer version of 5.
        {%- endcomment -%}
        {%- assign rating = block.settings.rating | default: 5 -%}
        <div class="ka-rev" {{ block.shopify_attributes }}>
          <div class="ka-rev__stars">
            {%- for i in (1..5) -%}
              {%- if i <= rating -%}&#9733;{%- else -%}&#9734;{%- endif -%}
            {%- endfor -%}
          </div>
          <p>{{ block.settings.quote }}</p>
          <div class="ka-rev__who">
            <div class="ka-rev__av">{{ block.settings.reviewer_name | slice: 0 }}</div>
            <div>
              <div class="ka-rev__nm">{{ block.settings.reviewer_name }}</div>
              <div class="ka-rev__src">{{ block.settings.source }}</div>
            </div>
          </div>
        </div>
      {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if more_url != blank -%}
      <div class="ka-voice__more"><a href="{{ more_url }}" target="_blank" rel="noopener">Read all {{ count }} reviews on Google &rarr;</a></div>
    {%- endif -%}
    {%- if section.settings.disclaimer != blank -%}
      <div class="ka-voice__note">{{ section.settings.disclaimer }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product Reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "rating_score", "label": "Aggregate score", "default": "4.9" },
    { "type": "text", "id": "rating_count", "label": "Review count", "default": "217" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by brides & their families, across the world." },
    { "type": "url",  "id": "google_url", "label": "Google reviews URL", "info": "Real Google Business Profile review link. Leave blank to hide the link." },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer note", "default": "Sample reviews shown — to be connected to the live Google profile", "info": "REMOVE before launch once real reviews are wired in." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 7,
      "settings": [
        { "type": "textarea", "id": "quote",         "label": "Quote" },
        { "type": "text",     "id": "reviewer_name", "label": "Reviewer name" },
        { "type": "text",     "id": "source",        "label": "Source", "default": "via Google" },
        { "type": "range",    "id": "rating",         "label": "Star rating", "min": 1, "max": 5, "step": 1, "default": 5, "info": "The reviewer's actual Google rating (1-5). Do not guess -- verify against the real Google Business Profile review." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Reviews",
      "blocks": [
        { "type": "review", "settings": { "quote": "I felt like the piece was made for my body — because it was. Three fittings over video from London, and it arrived perfect. I have never felt more myself at a wedding.", "reviewer_name": "Aisha R.", "source": "via Google" } },
        { "type": "review", "settings": { "quote": "I am the bride's mother and was nervous about ordering online. The concierge held my hand through every step. The embroidery in person is breathtaking.", "reviewer_name": "Meera S.", "source": "via Google" } },
        { "type": "review", "settings": { "quote": "Wore the corset drape to my sister's reception. Every single person asked where it was from. The fit was flawless and the fabric moves like water.", "reviewer_name": "Kavya N.", "source": "via Google" } }
      ]
    }
  ]
}
{% endschema %}
