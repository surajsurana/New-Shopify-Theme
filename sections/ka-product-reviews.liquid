{{ 'ka-product-reviews.css' | asset_url | stylesheet_tag }}
{%- comment -%} STAGING-ONLY FIXTURE TEST COPY (temporary) {%- endcomment -%}
{%- liquid
  assign fx_cards = 'w1 w2 w3 w4 w5 w6 w7 w8 w9 w10 w11 w12 w13 w14 w15 w16 w17 w18 w19 w20 w21 w22 w23 w24 w25 w26 w27 w28 w29 w30 w31 w32 w33 w34 w35 w36 w37 w38 w39 w40 w41 w42 w43 w44 w45 w46 w47 w48 w49 w50 w51 w52 w53 w54 w55 w56 w57 w58 w59 w60@@@Arushi G.@@@5###Good design love the outfit@@@Sakshi K.@@@4###Hostile <script>alert(1)</script> & "quoted" <img src=x onerror=alert(2)>@@@<i>Eve</i> O.@@@5###w1 w2 w3 w4 w5 w6 w7 w8 w9 w10 w11 w12 w13 w14 w15 w16 w17 w18 w19 w20 w21 w22 w23 w24 w25 w26 w27 w28 w29 w30 w31 w32 w33 w34 w35 w36 w37 w38 w39 w40 w41 w42 w43 w44 w45@@@Kavita S.@@@abc###Loved the collection, really cool styles.@@@Shivani R.@@@###w1 w2 w3 w4 w5 w6 w7 w8 w9 w10 w11 w12 w13 w14 w15 w16 w17 w18 w19 w20 w21 w22 w23 w24 w25 w26 w27 w28 w29 w30 w31 w32 w33 w34 w35 w36 w37 w38 w39 w40 w41 w42 w43 w44 w45 w46 w47 w48 w49 w50 w51 w52 w53 w54 w55 w56 w57 w58 w59 w60 w61 w62 w63 w64 w65 w66 w67 w68 w69 w70 w71 w72 w73 w74 w75 w76 w77 w78 w79 w80@@@Simran J.@@@5' | split: '###'
  assign fx_rating_number = '4.7'
  assign fx_rating_count = '67'
  assign fx_google_url = ''
  assign gr_quotes = 0
  for fxc in fx_cards
    assign fxq = fxc | split: '@@@' | first
    if fxq != blank
      assign gr_quotes = gr_quotes | plus: 1
    endif
  endfor

  assign use_synced = false
  if gr_quotes > 0 and fx_rating_number != blank and fx_rating_count != blank
    assign use_synced = true
  endif

  if use_synced
    assign score = fx_rating_number | escape
    assign count = fx_rating_count | escape
    assign synced_url = fx_google_url
    if synced_url != blank
      assign more_url = synced_url | escape
    else
      assign more_url = section.settings.google_url
    endif
  else
    assign score = section.settings.rating_score
    assign count = section.settings.rating_count
    assign more_url = section.settings.google_url
  endif
-%}

<section class="ka-voice" id="reviews">
  <div class="reveal">
    <div class="ka-voice__glogo">Google Reviews</div>
    <div class="ka-voice__summary">
      <div class="ka-voice__score">{{ score }}</div>
      <div style="text-align:left">
        <div class="ka-voice__summary"><span class="ka-voice__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span></div>
        <div class="ka-voice__cnt">Based on {{ count }} reviews</div>
      </div>
    </div>
    <div class="ka-voice__head">{{ section.settings.heading }}</div>

    <div class="ka-rev-grid">
      {%- if use_synced -%}
        {%- for fxc in fx_cards limit: 6 -%}
          {%- assign fxp = fxc | split: '@@@' -%}
          {%- if fxp[0] != blank -%}
            {%- assign rating = fxp[2] | plus: 0 -%}
            <div class="ka-rev">
              {%- if rating > 0 -%}
                <div class="ka-rev__stars">
                  {%- for i in (1..5) -%}
                    {%- if i <= rating -%}&#9733;{%- else -%}&#9734;{%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
              <p>{{ fxp[0] | truncatewords: 70, '…' | escape }}</p>
              <div class="ka-rev__who">
                <div class="ka-rev__av">{{ fxp[1] | slice: 0 | escape }}</div>
                <div>
                  <div class="ka-rev__nm">{{ fxp[1] | escape }}</div>
                  <div class="ka-rev__src">via Google</div>
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if more_url != blank -%}
      <div class="ka-voice__more"><a href="{{ more_url }}" target="_blank" rel="noopener">Read all {{ count }} reviews on Google &rarr;</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product Reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "rating_score", "label": "Aggregate score", "default": "4.9" },
    { "type": "text", "id": "rating_count", "label": "Review count", "default": "217" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by brides & their families, across the world." },
    { "type": "url",  "id": "google_url", "label": "Google reviews URL" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "limit": 7, "settings": [ { "type": "textarea", "id": "quote", "label": "Quote" }, { "type": "text", "id": "reviewer_name", "label": "Reviewer name" }, { "type": "text", "id": "source", "label": "Source", "default": "via Google" }, { "type": "range", "id": "rating", "label": "Star rating", "min": 1, "max": 5, "step": 1, "default": 5 } ] }
  ],
  "presets": [ { "name": "Product Reviews" } ]
}
{% endschema %}
