{{ 'ka-voice-of-bride.css' | asset_url | stylesheet_tag }}
{%- comment -%} STAGING-ONLY FIXTURE TEST COPY (temporary) {%- endcomment -%}
{%- liquid
  assign fx_cards = 'Five@@@A A.@@@5###Four@@@B B.@@@4###Seven-clamps@@@C C.@@@7###FourPointSix@@@D D.@@@4.6###Zero@@@E E.@@@0###NonNumeric@@@F F.@@@abc' | split: '###'
-%}
<section class="ka-voices"><div class="ka-voices__inner"><div class="ka-voices__grid">
{% for fxc in fx_cards limit: 6 %}
  {% assign fxp = fxc | split: '@@@' %}
  <div class="ka-voice-card">
    <p class="ka-voice-card__quote">{{ fxp[0] | escape }}</p>
    <div class="ka-voice-card__meta">
      <span class="ka-voice-card__name">{{ fxp[1] | escape }}</span>
      {%- comment -%} plus: 0 coerces to a number (a non-numeric value can never reach the aria-label); round + at_most: 5 clamp it to at most 5, and r > 0 below means 1-5 {%- endcomment -%}
      {%- assign r = fxp[2] | plus: 0 | round | at_most: 5 -%}
      {%- if r > 0 -%}<span class="ka-voice-card__stars" role="img" aria-label="{{ r }} out of 5 stars">{% for i in (1..5) %}{% if i <= r %}&#9733;{% else %}&#9734;{% endif %}{% endfor %}</span>{%- endif -%}
    </div>
  </div>
{% endfor %}
</div></div></section>

{% schema %}
{ "name": "Voice of the Bride", "tag": "section", "settings": [ { "type": "checkbox", "id": "show_section", "label": "Show", "default": false } ], "blocks": [ { "type": "review", "name": "Review", "limit": 6, "settings": [ { "type": "textarea", "id": "quote", "label": "Quote" } ] } ], "presets": [ { "name": "Voice of the Bride" } ] }
{% endschema %}
