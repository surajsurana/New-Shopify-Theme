{%- liquid
  assign looks = article.metafields.custom.client_diary_looks.value
  assign hero_image = blank
  for look in looks
    assign look_imgs = look.look_images.value
    if look_imgs.size > 0
      for img in look_imgs
        assign hero_image = img.image
        break
      endfor
    endif
    break
  endfor
-%}
<!-- HERODEBUG2 hero_image_src={{ hero_image.src }} hero_image_url={{ hero_image | image_url: width: 200 }} HERODEBUG2 END -->
