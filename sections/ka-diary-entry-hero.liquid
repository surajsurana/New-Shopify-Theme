{{ 'ka-diary-entry-hero.css' | asset_url | stylesheet_tag }}
{{ 'ka-animations.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  K&A Client Diaries — Entry Hero. Docs/client-diaries-build-spec.md
  §3 row A. Full-bleed (100svh), bottom-left content block (NOT
  centred — distinguishes this from the Index masthead). Same
  double-rAF "loaded" mechanism and scroll-progress/return-link
  crystallisation as sections/ka-article-hero.liquid.

  This is the ONLY entry section not fully skipped when consent is
  unset — it renders a quiet "not ready yet" fallback state instead
  of a blank page, WITHOUT exposing the client's name or any image
  (F3 publishing gate; see sections/ka-diary-featured.liquid header
  comment for the full data-model + gate writeup). Every other entry
  section on templates/article.diary.json (review, atelier, looks,
  more) renders nothing at all when consent is unset.

  Applies only to articles using the "diary" alternate template
  (templates/article.diary.json) — assigned per-article in Shopify
  Admin (Blog posts → article → Theme template dropdown → "diary").
  See templates/article.diary.json header comment.

  BUGFIX 2026-08-11: client_diary_looks (list.metaobject_reference)
  and look.look_images (list.file_reference) both need .value to
  resolve as iterable arrays in Liquid -- bare dot-access on a
  LIST-type reference metafield returns a non-sized wrapper, not the
  list itself. See sections/ka-diary-looks-spreads.liquid for the
  full writeup. Without this, look_count was always 0 and the hero
  image fallback to the first Look's first photo never fired.

  BUGFIX 2026-08-11 (second, found while verifying the first): the
  resolved list (.value) supports .size and `for...in` but NOT
  `.first` or bracket indexing (`looks[0]`) -- both silently return
  blank on this particular Drop type, confirmed via a live
  themeFilesUpsert diagnostic. `looks.first.look_images...` therefore
  always failed even after the .value fix above. Rewritten below as a
  for-loop with an immediate break, which does work reliably.
{%- endcomment -%}

<div class="entry-progress" id="entryProgress" aria-hidden="true"></div>

{%- liquid
  assign is_consented = false
  if article.metafields.custom.client_diary_consent == true
    assign is_consented = true
  endif
-%}

{%- if is_consented -%}
  <a href="{{ section.settings.index_url | default: '/pages/client-diaries' }}" class="entry-return" id="entryReturn">&larr; Back to Client Diaries</a>

  {%- liquid
    assign occasion_label = 'Client Diary'
    if article.tags contains 'Bridal'
      assign occasion_label = 'Bridal'
    elsif article.tags contains 'Sangeet & Cocktail'
      assign occasion_label = 'Sangeet & Cocktail'
    elsif article.tags contains 'Festive'
      assign occasion_label = 'Festive'
    elsif article.tags contains 'Mother & Family'
      assign occasion_label = 'Mother & Family'
    endif

    assign entry_year = article.metafields.custom.client_diary_year
    if entry_year == blank
      assign entry_year = article.published_at | date: '%Y'
    endif

    assign looks = article.metafields.custom.client_diary_looks.value
    assign look_count = looks.size

    assign first_name = article.title | split: ' ' | first

    assign hero_image = article.image
    if hero_image == blank and look_count > 0
      for first_look in looks
        assign first_look_images = first_look.look_images.value
        if first_look_images.size > 0
          for first_look_img in first_look_images
            assign hero_image = first_look_img.image
            break
          endfor
        endif
        break
      endfor
    endif
  -%}

  <header class="e-hero" id="entryHero" aria-label="{{ article.title | escape }}">
    <div class="e-hero__bg reveal-img" id="entryHeroBg">
      {%- if hero_image != blank -%}
        <img
          src="{{ hero_image | image_url: width: 1800 }}"
          alt="{{ hero_image.alt | escape | default: article.title | escape }}"
          loading="eager"
          fetchpriority="high"
          width="1800"
          height="1200"
          class="img-filter-editorial"
        />
      {%- else -%}
        <img
          src="{{ 'cd-simran-maroon-3.jpg' | asset_url }}"
          alt="{{ article.title | escape }}"
          loading="eager"
          fetchpriority="high"
          width="1800"
          height="1200"
          class="img-filter-editorial"
        />
      {%- endif -%}
    </div>
    <div class="e-hero__overlay"></div>
    <div class="e-hero__content">
      <p class="eyebrow eyebrow--on-dark e-hero__eyebrow">Client Diaries</p>
      <h1 class="e-hero__title">{{ first_name }}&rsquo;s Diary</h1>
      <p class="e-hero__meta">
        {{ occasion_label }} <span>&middot;</span> {{ entry_year }}{% if look_count > 0 %} <span>&middot;</span> {{ look_count }} Look{% if look_count != 1 %}s{% endif %}{% endif %}
      </p>
    </div>
  </header>

  <script>
    (function () {
      var heroBg = document.getElementById('entryHeroBg');
      if (heroBg) {
        requestAnimationFrame(function () { requestAnimationFrame(function () { heroBg.classList.add('loaded'); }); });
      }
      var returnLink = document.getElementById('entryReturn');
      var progress = document.getElementById('entryProgress');
      window.addEventListener('scroll', function () {
        var scrolled = window.scrollY > 60;
        if (returnLink) returnLink.classList.toggle('is-dark', scrolled);
        if (progress) {
          var docH = document.documentElement.scrollHeight - window.innerHeight;
          progress.style.width = docH > 0 ? Math.min(100, (window.scrollY / docH) * 100) + '%' : '0%';
        }
      }, { passive: true });
    })();
  </script>
{%- else -%}
  {%- comment -%}
    F3 fallback: no client name, no client image — consent is not
    confirmed, so nothing identifying her renders anywhere on this
    page. A quiet, on-brand "not ready" state rather than a blank or
    broken-looking page.
  {%- endcomment -%}
  <header class="e-hero e-hero--unpublished" aria-label="Diary not yet published">
    <div class="e-hero__content">
      <p class="eyebrow eyebrow--on-dark e-hero__eyebrow">Client Diaries</p>
      <h1 class="e-hero__title">This Diary Isn&rsquo;t Ready Yet.</h1>
      <p class="e-hero__meta"><a href="{{ section.settings.index_url | default: '/pages/client-diaries' }}" style="color:inherit;">&larr; Back to Client Diaries</a></p>
    </div>
  </header>
{%- endif -%}

{% schema %}
{
  "name": "Diary Entry Hero",
  "tag": "header",
  "settings": [
    { "type": "url", "id": "index_url", "label": "Client Diaries index URL", "info": "Defaults to /pages/client-diaries." }
  ],
  "presets": [
    { "name": "Diary Entry Hero" }
  ]
}
{% endschema %}
