{{ 'ka-collection-hero.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  K&A Collection Hero
  Spec: Docs/collection-build-spec.md, Section 2 ("Section 3 — Collection Hero"), F2.
  The single biggest structural departure from a generic Shopify collection page:
  opens as a full-bleed editorial chapter (one image, one Bodoni italic name, a
  piece count) rather than a filter sidebar + thumbnail wall.

  Image: section setting (image_picker), per F2 — none of the four real collections
  has dedicated photography yet except The Bloom Soirée. Falls back to the placeholder
  assignment in spec Section 5, keyed by collection.handle (not a typed name string),
  matching the established fallback pattern in ka-collections-directory.liquid.

  "Position" (the eyebrow's "0X") is a per-instance section setting because Liquid has
  no native "index of this collection in the Maison" concept — it must mirror the fixed
  homepage Collections Directory order (Festive Edit 01, Bloom Soirée 02, Chamakk 03,
  Barre Oblique 04) per CD Note 5. Set manually per collection.json instance.

  2026-10-20 (category pages): image lookup order is now
    1. section setting hero_image
    2. collection metafield custom.hero_image (file_reference) -- the four
       silhouette pages (Lehengas, Drapes, Indo-Western, Corsets) use this
    3. the known-capsule handle images below
    4. collection.image (Admin collection image)
    5. charcoal
  Eyebrow: collection metafield custom.hero_eyebrow when set, else
  "The Collections", plus " -- {position}" only when the position setting is
  non-blank (numerals dropped, D2). Optional metafield custom.hero_focus
  (e.g. "50% 8%") sets object-position so portrait photographs are not
  cropped through the face; default stays "center 30%".
{%- endcomment -%}

{%- liquid
  assign hero_mf_image = collection.metafields.custom.hero_image.value
  assign hero_mf_eyebrow = collection.metafields.custom.hero_eyebrow.value
  assign hero_mf_focus = collection.metafields.custom.hero_focus.value
  assign hero_focus_style = ''
  if hero_mf_focus != blank
    assign hero_focus_safe = hero_mf_focus | strip | escape
    assign hero_focus_style = 'object-position: ' | append: hero_focus_safe | append: ';'
  endif
-%}

<section class="ka-coll-hero">
  <div class="ka-coll-hero__frame reveal-img">
    {% if section.settings.hero_image != blank %}
      <img
        src="{{ section.settings.hero_image | image_url: width: 1800 }}"
        alt="{{ section.settings.hero_image.alt | escape | default: collection.title }}"
        loading="eager"
        fetchpriority="high"
        width="1800"
        height="1100"
        class="img-filter-coll-page-dark"
        {% if hero_focus_style != blank %}style="{{ hero_focus_style }}"{% endif %}
      />
    {% elsif hero_mf_image != blank %}
      <img
        src="{{ hero_mf_image | image_url: width: 1800 }}"
        alt="{{ hero_mf_image.alt | default: collection.title | escape }}"
        loading="eager"
        fetchpriority="high"
        width="1800"
        height="1100"
        class="img-filter-coll-page-dark"
        {% if hero_focus_style != blank %}style="{{ hero_focus_style }}"{% endif %}
      />
    {% else %}
      {%- assign handle_lower = collection.handle | downcase -%}
      {%- case handle_lower -%}
        {%- when 'first-love' -%}
          <img src="{{ 'first-love-hero.jpg' | asset_url }}" alt="{{ collection.title }}" loading="eager" fetchpriority="high" width="1800" height="1100" class="img-filter-coll-page-dark" />
        {%- when 'the-bloom-soiree' -%}
          <img src="{{ 'bloom-soiree-hero.jpg' | asset_url }}" alt="{{ collection.title }}" loading="eager" fetchpriority="high" width="1800" height="1100" class="img-filter-coll-page-dark" />
        {%- when 'the-festive-edit' -%}
          {%- comment -%} Interim stand-in — no suitable studio image yet. Flag for dedicated shoot. {%- endcomment -%}
          <img src="{{ 'celebrity-editorial.jpg' | asset_url }}" alt="{{ collection.title }}" loading="eager" fetchpriority="high" width="1800" height="1100" class="img-filter-coll-page-dark" />
        {%- when 'chamak' -%}
          <img src="{{ 'chamak-hero.jpg' | asset_url }}" alt="{{ collection.title }}" loading="eager" fetchpriority="high" width="1800" height="1100" class="img-filter-coll-page-dark" />
        {%- when 'barre-oblique' -%}
          <img src="{{ 'barre-hero.jpg' | asset_url }}" alt="{{ collection.title }}" loading="eager" fetchpriority="high" width="1800" height="1100" class="img-filter-coll-page-dark" />
        {%- when 'wedding-festive', 'the-wedding-festive-collection-22' -%}
          <img src="{{ 'wedding-festive-hero.jpg' | asset_url }}" alt="{{ collection.title }}" loading="eager" fetchpriority="high" width="1800" height="1100" class="img-filter-coll-page-dark" />
        {%- when 'bestsellers' -%}
          <img src="{{ 'bestsellers-hero.jpg' | asset_url }}" alt="{{ collection.title }}" loading="eager" fetchpriority="high" width="1800" height="1100" class="img-filter-coll-page-dark" />
        {%- else -%}
          {%- if collection.image != blank -%}
            <img src="{{ collection.image | image_url: width: 1800 }}" alt="{{ collection.image.alt | default: collection.title | escape }}" loading="eager" fetchpriority="high" width="1800" height="1100" class="img-filter-coll-page-dark"{% if hero_focus_style != blank %} style="{{ hero_focus_style }}"{% endif %} />
          {%- else -%}
            <div style="background: var(--c-charcoal-2); width:100%; height:100%;"></div>
          {%- endif -%}
      {%- endcase -%}
    {% endif %}
    <div class="ka-coll-hero__overlay"></div>
    <div class="ka-coll-hero__content">
      <div>
        <p class="eyebrow eyebrow--on-dark ka-coll-hero__eyebrow reveal">{% if hero_mf_eyebrow != blank %}{{ hero_mf_eyebrow | escape }}{% else %}The Collections{% if section.settings.position != blank %} — {{ section.settings.position }}{% endif %}{% endif %}</p>
        <h1 class="ka-coll-hero__title reveal reveal-delay-1">{{ collection.title }}</h1>
      </div>
      <div class="ka-coll-hero__meta reveal reveal-delay-2">
        <span class="num">{{ collection.all_products_count }}</span>
        <span>Pieces in this collection</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Hero",
  "tag": "div",
  "class": "ka-collection-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Collection hero image",
      "info": "Pre-populate with the placeholder assigned in Docs/collection-build-spec.md Section 5 until real capsule photography exists. Swap any time — no code change needed."
    },
    {
      "type": "text",
      "id": "position",
      "label": "Optional number in eyebrow (e.g. 01)",
      "info": "Leave blank (recommended) to print just \"The Collections\". Numerals were dropped in the 2026 category-pages release."
    }
  ],
  "presets": [
    { "name": "Collection Hero" }
  ]
}
{% endschema %}
