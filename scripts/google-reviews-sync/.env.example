# Copy to .env locally, or set as real environment variables in the
# systemd service unit on the droplet. Never commit a real .env file.

# --- Google Business Profile API (access approved 2026-09-14). The next three
# --- are written for you by `authorize.py` (one-time, run locally) -- see README.md ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional -- leave blank to auto-discover on first run, then pin here:
GOOGLE_ACCOUNT_ID=
GOOGLE_LOCATION_ID=
# The public "leave a review" link for K&A's Google Business Profile (public,
# not a secret). It becomes the homepage "Read all reviews" button target:
GOOGLE_REVIEW_URL=https://g.page/r/Cf2-UdWjwY_SEAI/review

# --- Shopify Admin API ---
# Classic admin "custom apps" can no longer be created. Create an app in the
# Shopify Dev Dashboard (name it "K&A Reviews Sync"), install it on the store,
# then copy its Client ID and Client secret from the app's Settings page into
# your LOCAL .env (never paste them in chat, never commit them). Each run swaps
# them for a short-lived (~24h) token via the client-credentials grant; the token
# is kept in memory only. See README.md.
SHOPIFY_STORE_DOMAIN=d21bac.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional legacy fallback, only used if CLIENT_ID/SECRET above are empty:
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_API_VERSION=2025-01
