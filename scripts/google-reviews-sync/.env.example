# Copy to .env locally, or set as real environment variables in the
# systemd service unit on the droplet. Never commit a real .env file.

# --- Google Business Profile API (BLOCKED until Suraj's Basic API Access
# --- application is approved -- see google_business_client.py) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional -- leave blank to auto-discover on first run, then pin here:
GOOGLE_ACCOUNT_ID=
GOOGLE_LOCATION_ID=
# The public g.page/r/... "leave a review" URL, copied once from the
# Business Profile dashboard. NOT blocked on API access -- can be set now.
GOOGLE_REVIEW_URL=

# --- Shopify Admin API (NOT blocked -- can be set up today) ---
SHOPIFY_STORE_DOMAIN=d21bac.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_API_VERSION=2025-01
