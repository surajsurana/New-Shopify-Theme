.env
!.env.example
__pycache__/
*.pyc
venv/

# Google OAuth client secret JSON for the GBP reviews sync -- real credential,
# never commit.
Google My Business Reviews API/
client_secret*.json

# Lookbook source PDFs — large binaries, canonical copies live in the
# K&A Lookbooks project; kept here as a local working copy only.
Lookbooks/

# Raw source material (client docx, WhatsApp photos) -- local/Drive only;
# the finished content lives in Shopify and the build specs in Docs/.
Client Diaries/
Content/

# Old Codex copies of CLAUDE.md and the agents (Aug 2026, since drifted from
